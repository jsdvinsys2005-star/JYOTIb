class Employee {
    private int id;
    private String name;
    private double salary;

    public Employee(int id, String name, double salary) {
        this.id = id;
        this.name = name;
        this.salary = salary;
    }

    public int getId() {
        return id;
    }

    public String getName() {
        return name;
    }

    public double getSalary() {
        return salary;
    }

    public void display() {
        System.out.println(id + "\t" + name + "\t" + salary + "\tEmployee");
    }
}

class Developer extends Employee {
    public Developer(int id, String name, double salary) {
        super(id, name, salary);
    }

    @Override
    public void display() {
        System.out.println(getId() + "\t" + getName() + "\t" + getSalary() + "\tDeveloper");
    }
}

class Manager extends Employee {
    public Manager(int id, String name, double salary) {
        super(id, name, salary);
    }

    @Override
    public void display() {
        System.out.println(getId() + "\t" + getName() + "\t" + getSalary() + "\tManager");
    }
}

public class Main {
    public static void main(String[] args) {

        System.out.println("ID\tName\t\tSalary\tPost");
        System.out.println("----------------------------------------------");

        Employee e1 = new Developer(101, "Rahul", 45000);
        Employee e2 = new Manager(102, "Amit", 65000);
        Employee e3 = new Employee(103, "Priya", 50000);
        Employee e4 = new Developer(104, "Neha", 47000);
        Employee e5 = new Manager(105, "Rohan", 70000);
        Employee e6 = new Employee(106, "Kiran", 42000);
        Employee e7 = new Developer(107, "Sneha", 48000);
        Employee e8 = new Manager(108, "Vijay", 75000);

        e1.display();
        e2.display();
        e3.display();
        e4.display();
        e5.display();
        e6.display();
        e7.display();
        e8.display();
    }
}
