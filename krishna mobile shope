<!DOCTYPE html>
<html>
<head>
<title>Krishna Mobile Shop</title>

<style>
body{
    margin:0;
    font-family:Arial;
    background:#f2f2f2;
}

header{
    background:#1565c0;
    color:white;
    padding:20px;
    text-align:center;
}

nav{
    background:#333;
    padding:10px;
    text-align:center;
}

nav a{
    color:white;
    margin:15px;
    text-decoration:none;
}

.container{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
}

.product{
    background:white;
    width:250px;
    margin:20px;
    padding:20px;
    text-align:center;
    border-radius:10px;
    box-shadow:0 0 10px gray;
}

.product img{
    width:150px;
    height:150px;
}

button{
    background:#1565c0;
    color:white;
    border:none;
    padding:10px;
    cursor:pointer;
    border-radius:5px;
}

button:hover{
    background:#0d47a1;
}

#cart{
    background:white;
    margin:20px;
    padding:20px;
    border-radius:10px;
}
</style>

</head>

<body>

<header>
<h1>Krishna Mobile Shop</h1>
<p>Best Smartphones At Best Price</p>
</header>


<nav>
<a href="#">Home</a>
<a href="#">Mobiles</a>
<a href="#">Contact</a>
</nav>


<h2 style="text-align:center;">Our Mobiles</h2>

<div class="container">

<div class="product">
<img src="https://via.placeholder.com/150">
<h3>Samsung Galaxy</h3>
<p>₹25000</p>
<button onclick="addCart('Samsung Galaxy')">Add Cart</button>
</div>


<div class="product">
<img src="https://via.placeholder.com/150">
<h3>iPhone 15</h3>
<p>₹70000</p>
<button onclick="addCart('iPhone 15')">Add Cart</button>
</div>


<div class="product">
<img src="https://via.placeholder.com/150">
<h3>OnePlus 12</h3>
<p>₹50000</p>
<button onclick="addCart('OnePlus 12')">Add Cart</button>
</div>


</div>


<div id="cart">
<h2>Shopping Cart</h2>
<ul id="items"></ul>
</div>


<script>

function addCart(product){

let li=document.createElement("li");

li.innerHTML=product;

document.getElementById("items").appendChild(li);

alert(product+" Added To Cart");

}

</script>


</body>
</html>
